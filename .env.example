# Porta do app
PORT=3333

# Pasta com seus currículos-fonte (relativa ao projeto)
CURRICULOS_DIR=curriculos

# --- Ollama (local, gratuito e privado: seus dados não saem do computador) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Janela de contexto (tokens). Aumente se tiver muitos currículos; diminua se faltar memória de vídeo.
OLLAMA_NUM_CTX=16384

# --- Groq (nuvem, plano gratuito, muito rápido) — chave em https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (nuvem, plano gratuito) — chave em https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
